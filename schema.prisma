// ============================================================
// SCHEMA — Sistema de Controle de Estoque (Clínica Veterinária)
// MVP — Fase 1
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------

enum UserRole {
  ADMIN
  FUNCIONARIO
}

enum MovementType {
  IN  // entrada
  OUT // saída
}

enum MovementReason {
  COMPRA          // entrada padrão
  USO_INTERNO
  ATENDIMENTO
  PERDA
  DESCARTE
  VENCIMENTO
  OUTRO
}

enum InventoryStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AdjustmentReason {
  PERDA
  VENCIMENTO
  USO_NAO_REGISTRADO
  ERRO_CADASTRO
  DESCARTE
  OUTRO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  INVENTORY_OPEN
  INVENTORY_CLOSE
}

// ------------------------------------------------------------
// USERS
// ------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(FUNCIONARIO)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relações — todas as ações rastreáveis por usuário
  stockMovements    StockMovement[]
  stockAdjustments  StockAdjustment[] @relation("AdjustmentUser")
  approvedAdjustments StockAdjustment[] @relation("ApprovedByUser")
  inventoriesLed    Inventory[]
  auditLogs         AuditLog[]

  @@map("users")
}

// ------------------------------------------------------------
// CATEGORIES
// ------------------------------------------------------------

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())

  products  Product[]

  @@map("categories")
}

model Supplier {
  id          String   @id @default(uuid())
  name        String   @unique
  document    String?  @unique
  contactName String?
  email       String?
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stockMovements StockMovement[]

  @@index([active])
  @@map("suppliers")
}

// ------------------------------------------------------------
// PRODUCTS
// ------------------------------------------------------------

model Product {
  id            String   @id @default(uuid())
  name          String
  sku           String   @unique
  barcode       String?  @unique
  categoryId    String
  unit          String   // unidade de medida (un, cx, ml, kg...)
  minStock      Int      @default(0)
  maxStock      Int?
  location      String?
  currentStock  Int      @default(0) // campo cacheado — recalculado em transação
  active        Boolean  @default(true)
  tracksBatch   Boolean  @default(false) // controla lote/validade (vacinas, medicamentos...)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category         Category           @relation(fields: [categoryId], references: [id])
  stockMovements   StockMovement[]
  inventoryItems   InventoryItem[]
  stockAdjustments StockAdjustment[]
  batches          Batch[]

  @@index([categoryId])
  @@index([active])
  @@map("products")
}

// ------------------------------------------------------------
// BATCHES (lotes e validade — Fase 2)
// ------------------------------------------------------------

model Batch {
  id             String   @id @default(uuid())
  productId      String
  batchNumber    String?
  expirationDate DateTime
  quantity       Int      // quantidade restante nesse lote (decrementada nas saídas)
  supplier       String?
  receivedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  product        Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]

  @@index([productId])
  @@index([expirationDate])
  @@map("batches")
}

// ------------------------------------------------------------
// STOCK MOVEMENTS (entradas e saídas)
// ------------------------------------------------------------

model StockMovement {
  id            String         @id @default(uuid())
  productId     String
  type          MovementType
  quantity      Int            // sempre positivo; o "type" define o sinal
  reason        MovementReason
  supplier      String?
  supplierId    String?
  invoiceNumber String?
  userId        String
  note          String?
  batchId       String?        // vincula a movimentação a um lote específico (produtos com tracksBatch)
  createdAt     DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  batch   Batch?  @relation(fields: [batchId], references: [id])
  supplierEntity Supplier? @relation(fields: [supplierId], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@index([supplierId])
  @@map("stock_movements")
}

// ------------------------------------------------------------
// INVENTORY (contagens físicas)
// ------------------------------------------------------------

model Inventory {
  id           String          @id @default(uuid())
  name         String
  responsibleId String
  status       InventoryStatus @default(IN_PROGRESS)
  blindMode    Boolean         @default(false)
  createdAt    DateTime        @default(now())
  closedAt     DateTime?

  responsible User            @relation(fields: [responsibleId], references: [id])
  items       InventoryItem[]

  @@index([status])
  @@map("inventories")
}

model InventoryItem {
  id           String   @id @default(uuid())
  inventoryId  String
  productId    String
  expectedQty  Int      // snapshot do estoque no momento da abertura
  countedQty   Int?     // preenchido durante a contagem
  divergence   Int?     // countedQty - expectedQty (calculado ao confirmar)
  note         String?
  countedAt    DateTime?

  inventory  Inventory          @relation(fields: [inventoryId], references: [id])
  product    Product            @relation(fields: [productId], references: [id])
  adjustment StockAdjustment?

  @@unique([inventoryId, productId])
  @@index([inventoryId])
  @@map("inventory_items")
}

// ------------------------------------------------------------
// STOCK ADJUSTMENTS (divergência → ajuste)
// ------------------------------------------------------------

model StockAdjustment {
  id              String            @id @default(uuid())
  productId       String
  inventoryItemId String?           @unique // nullable: ajuste pode não vir de inventário
  previousQty     Int
  newQty          Int
  difference      Int
  reason          AdjustmentReason
  note            String?
  userId          String            // quem registrou/solicitou
  approvedById    String?           // quem aprovou (admin)
  createdAt       DateTime          @default(now())

  product       Product        @relation(fields: [productId], references: [id])
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  user          User           @relation("AdjustmentUser", fields: [userId], references: [id])
  approvedBy    User?          @relation("ApprovedByUser", fields: [approvedById], references: [id])

  @@index([productId])
  @@map("stock_adjustments")
}

// ------------------------------------------------------------
// AUDIT LOG (rastreabilidade genérica)
// ------------------------------------------------------------

model AuditLog {
  id         String      @id @default(uuid())
  entityType String      // ex: "Product", "StockMovement", "Inventory"
  entityId   String
  action     AuditAction
  userId     String
  changes    Json?       // snapshot antes/depois, quando aplicável
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
